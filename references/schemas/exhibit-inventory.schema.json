{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-translation-pro.local/schemas/exhibit-inventory.schema.json",
  "title": "Book Translation Pro Exhibit Inventory",
  "type": "object",
  "required": ["schema_version", "body_style", "exhibits"],
  "$defs": {
    "rect": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "cells": {"type": "array", "items": {"type": "string"}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "body_style": {
      "type": "object",
      "required": ["font", "size"],
      "properties": {
        "font": {"type": "string"},
        "size": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "exhibits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "page", "rotation", "caption", "caption_bbox", "body_size", "classification", "reason", "part", "parts"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "rotation": {"enum": [0, 90, -90]},
          "caption": {"type": "string"},
          "caption_bbox": {"$ref": "#/$defs/rect"},
          "body_size": {"type": "number", "exclusiveMinimum": 0},
          "classification": {"enum": ["diagram", "table_grid", "table_lists", "raster", "uncertain"]},
          "reason": {"type": "string", "minLength": 1},
          "part": {"type": "integer", "minimum": 1},
          "parts": {"type": "integer", "minimum": 1},
          "orientation": {"enum": ["above_caption", "below_caption"]},
          "crop": {"$ref": "#/$defs/rect"},
          "region": {"$ref": "#/$defs/rect"},
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "keep", "lines", "bbox"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "keep": {"type": "boolean"},
                "lines": {"type": "integer", "minimum": 1},
                "bbox": {"$ref": "#/$defs/rect"}
              },
              "additionalProperties": false
            }
          },
          "table": {
            "type": "object",
            "required": ["mode", "header", "meta", "rows", "numeric_columns", "continues"],
            "properties": {
              "mode": {"enum": ["grid", "lists"]},
              "header": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/cells"}]},
              "meta": {"type": "array", "items": {"$ref": "#/$defs/cells"}},
              "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cells"}},
              "items": {"type": "array", "items": {"$ref": "#/$defs/cells"}},
              "numeric_columns": {"type": "array", "items": {"type": "integer", "minimum": 0}},
              "continues": {"type": "boolean"},
              "row_tops": {"type": "array", "items": {"type": "number"}}
            },
            "additionalProperties": false
          },
          "checks": {
            "type": "object",
            "required": ["characters_missing", "characters_extra", "numbers", "totals"],
            "properties": {
              "characters_missing": {"type": "string"},
              "characters_extra": {"type": "string"},
              "numbers": {"type": "integer", "minimum": 0},
              "totals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["column", "stated", "sum_of_rows", "verdict"],
                  "properties": {
                    "column": {"type": "string"},
                    "stated": {"type": "number"},
                    "sum_of_rows": {"type": "number"},
                    "verdict": {"enum": ["exact", "rounding", "mismatch", "not_checkable"]}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {"if": {"properties": {"classification": {"const": "diagram"}}},
           "then": {"required": ["crop", "orientation", "labels"]}},
          {"if": {"properties": {"classification": {"enum": ["table_grid", "table_lists"]}}},
           "then": {"required": ["region", "orientation", "table", "checks"]}},
          {"if": {"properties": {"classification": {"const": "raster"}}},
           "then": {"required": ["crop"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
