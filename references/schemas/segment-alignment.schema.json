{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-translation-pro.local/schemas/segment-alignment.schema.json",
  "title": "Book Translation Pro segment alignment",
  "type": "object",
  "required": ["schema_version", "source_fingerprint", "target_language", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_language": {"type": "string", "minLength": 2},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "unit_id", "book_node_id", "source_segment_ids", "source_text", "target_text", "source_sha256", "target_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^align-[0-9]{4,}$"},
          "order": {"type": "integer", "minimum": 0},
          "unit_id": {"type": "string"},
          "book_node_id": {"type": ["string", "null"]},
          "source_segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "source_text": {"type": "string", "minLength": 1},
          "target_text": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "target_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
